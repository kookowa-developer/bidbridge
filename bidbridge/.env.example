# --- required in production ---
BIDBRIDGE_SECRET_KEY=            # openssl rand -hex 32  (app refuses to start in production with the dev default)
BIDBRIDGE_DATABASE_URL=          # Neon/Postgres URL, e.g. postgresql://user:pass@host/db?sslmode=require

# --- optional ---
BIDBRIDGE_ALLOW_REGISTRATION=true
BIDBRIDGE_LLM_ENABLED=false
BIDBRIDGE_ANTHROPIC_API_KEY=     # enables LLM extraction and Claude-vision OCR (needed for scanned PDFs on Vercel)
BIDBRIDGE_OCR_PROVIDER=auto      # auto | tesseract | anthropic | none
BIDBRIDGE_TELEGRAM_BOT_TOKEN=
BIDBRIDGE_TELEGRAM_BOT_USERNAME=
BIDBRIDGE_TELEGRAM_WEBHOOK_SECRET=   # same value you pass as secret_token to setWebhook
BIDBRIDGE_CRON_SECRET=               # on Vercel set CRON_SECRET too (same value): Vercel sends it as a Bearer token
